{
  "name": "ancore-frontend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src tests build.mjs",
    "format:check": "prettier --check src tests build.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
