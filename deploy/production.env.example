# ./ancore-install.sh setup zbiera ustawienia i generuje deploy/.env z losowymi sekretami.
# IPv4 i port HTTP; administrator Django powstaje później, bez zapisu hasła w tym pliku.
ANCORE_PROJECT=ancore-prod
ANCORE_HOST=192.168.1.10
ANCORE_PUBLIC_URL=http://192.168.1.10:8080
ANCORE_HTTP_PORT=8080
SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
ONLYOFFICE_JWT_SECRET=
ANCORE_RELEASE=local
ONLYOFFICE_IMAGE=onlyoffice/documentserver:10.0.0.1
