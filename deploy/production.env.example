# sh install.sh automatycznie generuje deploy/.env z losowymi sekretami.
# Pliki, baza i archiwa backupów NIE są szyfrowane.
ANCORE_PROJECT=ancore-prod
ANCORE_PUBLIC_URL=
ANCORE_HOST=_
ANCORE_AUTHORITY=localhost
ANCORE_ALLOWED_HOSTS=*
ANCORE_ALLOW_IP_HOSTS=true
ANCORE_SCHEME=http
ANCORE_HTTPS=false
ANCORE_HSTS_SECONDS=0
# http: dostęp przez IP. direct: certyfikat Nginx. external: zewnętrzny proxy HTTPS.
ANCORE_TLS_MODE=http
ANCORE_BIND=0.0.0.0
ANCORE_HTTP_PORT=8080
ANCORE_HTTPS_PORT=443
ANCORE_TLS_DIR=/etc/ancore/tls
ANCORE_BACKUP_DIR=/srv/ancore-backups
SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
ONLYOFFICE_JWT_SECRET=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=14
ANCORE_RELEASE=local
ONLYOFFICE_IMAGE=onlyoffice/documentserver:10.0.0.1
