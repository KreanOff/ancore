map $http_upgrade $ancore_connection { default upgrade; '' close; }
resolver 127.0.0.11 valid=10s ipv6=off;
upstream ancore_backend { zone ancore_backend 64k; server backend:8000 resolve; }
upstream ancore_office { zone ancore_office 64k; server onlyoffice:80 resolve; }

${ANCORE_HTTP_REDIRECT}
server {
    ${ANCORE_LISTEN}
    ${ANCORE_TLS_SETTINGS}
    server_name ${ANCORE_HOST};
    server_tokens off;
    # 20 files x 10 MiB, plus form fields and multipart boundaries.
    client_max_body_size 225m;
    # Query strings can contain signed ONLYOFFICE capabilities.
    access_log off;
    error_log /dev/stderr warn;
    add_header X-Content-Type-Options nosniff always;

    location /static/ {
        alias /srv/static/;
        expires 1h;
        disable_symlinks on;
    }
    location ~* ^/media/(profile_photos|workplace_photos)/([^/]+\.(?:jpg|jpeg|png|webp))$ {
        alias /srv/media/$1/$2;
        disable_symlinks on;
    }
    location /media/ { return 404; }
    location = /onlyoffice { return 308 /onlyoffice/; }
    location /onlyoffice/ {
        proxy_pass http://ancore_office/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host/onlyoffice;
        proxy_set_header X-Forwarded-Proto ${ANCORE_SCHEME};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ancore_connection;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
    location / {
        proxy_pass http://ancore_backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto ${ANCORE_SCHEME};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 130s;
    }
}

# ONLYOFFICE uses signed server-to-server URLs, with no browser session.
# This listener is never published on the host.
server {
    listen 8081;
    server_name _;
    access_log off;
    client_max_body_size 25m;
    location = /health/ready/ {
        proxy_pass http://ancore_backend;
        proxy_set_header Host ${ANCORE_AUTHORITY};
        proxy_set_header X-Forwarded-Proto ${ANCORE_SCHEME};
    }
    location ~ ^/(drive-)?office-service/[0-9a-f-]+/(source|callback)/$ {
        proxy_pass http://ancore_backend;
        proxy_set_header Host ${ANCORE_AUTHORITY};
        proxy_set_header X-Forwarded-Proto ${ANCORE_SCHEME};
        proxy_read_timeout 130s;
    }
    location / { return 404; }
}
