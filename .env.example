# Skopiuj do .env i uzupełnij dane własnej bazy PostgreSQL.
# Przykład służy wyłącznie do lokalnego developmentu.
DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

DB_NAME=ancore
DB_USER=ancore
DB_PASSWORD=
DB_HOST=127.0.0.1
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL="Ancore <noreply@example.com>"
DB_PORT=5432
