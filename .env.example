# Skopiuj do .env i uzupełnij dane własnej bazy PostgreSQL.
# Przykład służy wyłącznie do lokalnego developmentu.
DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Opcjonalny prefiks PATH dla lokalnego buildu (katalogi Node.js i pnpm).
FRONTEND_BUILD_PATH=

DB_NAME=ancore
DB_USER=ancore
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
